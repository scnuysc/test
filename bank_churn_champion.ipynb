def add_business_features(df: pd.DataFrame) -> pd.DataFrame:
    work = df.copy()
    # 登录活跃
    if set(['f14','f15','f16']).issubset(work.columns):
        work['mb_login_total'] = work[['f14','f15','f16']].sum(axis=1)
        work['mb_login_var'] = work[['f14','f15','f16']].var(axis=1)
        work['mb_login_trend_6to1'] = work['f14'] - work['f16']
        work['mb_login_ratio_6to1'] = (work['f14'] + 1.0) / (work['f16'] + 1.0)
    # 交易月度环比/比率
    for p in ['cnt', 'amt']:
        a, b, c = f'{p}_202502', f'{p}_202503', f'{p}_202504'
        if set([a,b,c]).issubset(work.columns):
            work[f'{p}_mom_03_vs_02'] = work[b] - work[a]
            work[f'{p}_mom_04_vs_03'] = work[c] - work[b]
            work[f'{p}_ratio_03_vs_02'] = (work[b] + 1.0) / (work[a] + 1.0)
            work[f'{p}_ratio_04_vs_03'] = (work[c] + 1.0) / (work[b] + 1.0)
    # 资产汇总
    for x, y, name in [('f17','f19','asset_point'), ('f18','f20','asset_mavg3')]:
        if x in work.columns and y in work.columns:
            work[f'{name}_sum'] = work[x].fillna(0) + work[y].fillna(0)
            work[f'{name}_inv_ratio'] = (work[y].fillna(0) + 1.0) / (work[f'{name}_sum'] + 1.0)
    # 比率分桶
    for col in ['depo_decay_ratio','inv_decay_ratio','asset_loss_ratio']:
        if col in work.columns:
            work[f'{col}_bin'] = pd.qcut(work[col], q=10, duplicates='drop', labels=False)
    return work

train = add_business_features(train)
print('Added business features, now shape=', train.shape)# 1. 数据加载与基础EDA

