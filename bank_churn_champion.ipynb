from collections import defaultdict

id_col = 'id'
label_col = 'label'


def winsorize_series(s: pd.Series, lower_q: float = 0.01, upper_q: float = 0.99) -> pd.Series:
    x = pd.to_numeric(s, errors='coerce')
    lo = np.nanquantile(x, lower_q)
    hi = np.nanquantile(x, upper_q)
    return x.clip(lo, hi)


def cross_fit_target_encoding(df: pd.DataFrame, cols: List[str], target: str, n_splits: int = 5, noise: float = 0.0):
    df = df.copy()
    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=RANDOM_STATE)
    global_mean = df[target].mean()
    maps = {}
    for col in cols:
        maps[col] = {'global_mean': global_mean, 'map': {}}
        oof = pd.Series(index=df.index, dtype=float)
        for tr_idx, va_idx in skf.split(df, df[target]):
            tr, va = df.iloc[tr_idx], df.iloc[va_idx]
            m = tr.groupby(col)[target].mean()
            oof.iloc[va_idx] = va[col].map(m).fillna(global_mean)
        if noise > 0:
            oof += np.random.normal(0, noise, size=len(oof))
        df[f'{col}_te'] = oof
        maps[col]['map'] = df.groupby(col)[target].mean().to_dict()
    return df, maps


def apply_target_encoding(df: pd.DataFrame, maps: Dict[str, Dict]) -> pd.DataFrame:
    df = df.copy()
    for col, m in maps.items():
        gm = m['global_mean']; mp = m['map']
        df[f'{col}_te'] = df[col].map(mp).fillna(gm)
    return df


def preprocess(df: pd.DataFrame, is_train: bool = True, enc_maps: Optional[Dict[str, Dict]] = None):
    work = df.copy()
    # 删除单值/全缺
    nunique = work.nunique(dropna=False)
    drop_cols = [c for c in work.columns if nunique[c] <= 1]
    if drop_cols:
        work = work.drop(columns=drop_cols)

    # 识别日期列并转距锚点天数
    for c in list(work.columns):
        if c not in [id_col, label_col] and ('date' in c or c == 'f11'):
            ts = pd.to_datetime(work[c], errors='coerce')
            if ts.notna().any():
                work[c + '_days_from_anchor'] = (ANCHOR_DATE - ts).dt.days
                work = work.drop(columns=[c])

    # 类型划分
    feature_cols = [c for c in work.columns if c not in [id_col, label_col]]
    numeric_cols, categorical_cols = [], []
    for c in feature_cols:
        if pd.api.types.is_numeric_dtype(work[c]):
            numeric_cols.append(c)
        else:
            categorical_cols.append(c)

    # 缺失
    med = work[numeric_cols].median(numeric_only=True)
    work[numeric_cols] = work[numeric_cols].fillna(med)
    for c in categorical_cols:
        work[c] = work[c].fillna('UNK').astype(str)

    # 高基数裁剪
    def cap_top_k(series: pd.Series, k: int = 60):
        vc = series.value_counts()
        keep = set(vc.index[:k])
        return series.where(series.isin(keep), other='OTHER')
    for c in categorical_cols:
        work[c] = cap_top_k(work[c], k=60)

    # 目标编码
    if is_train:
        work, enc_maps = cross_fit_target_encoding(work, categorical_cols, target=label_col, n_splits=5, noise=0.0)
    else:
        if enc_maps is None:
            raise ValueError('enc_maps required for inference')
        work = apply_target_encoding(work, enc_maps)

    # 截断与缩放
    for c in numeric_cols:
        work[c] = winsorize_series(work[c])
    scaler = StandardScaler()
    scaled_cols = numeric_cols + [f'{c}_te' for c in categorical_cols]
    work[scaled_cols] = scaler.fit_transform(work[scaled_cols]) if is_train else scaler.transform(work[scaled_cols])

    final_features = [c for c in work.columns if c not in [id_col, label_col]]
    return work, enc_maps, final_features

proc_train, enc_maps, final_features = preprocess(train, is_train=True)
X_all = proc_train[final_features]
y_all = proc_train[label_col].astype(int)
