-- 0. Hive SQL：三表融合与特征扩展（精简冗余 + 增强变化特征）

CREATE TABLE IF NOT EXISTS aplthive_ohzdl_0mgk1_d.risk_tx_view AS
SELECT id, f1 AS tx_type, f4 AS dc_flag, f11 AS amount, f13 AS tx_date, f16 AS channel
FROM aplthive_ohzdl_0mgk1_d.risk_train
WHERE f13 >= '2025-02-01' AND f13 <= '2025-04-30';

CREATE TABLE IF NOT EXISTS aplthive_ohzdl_0mgk1_d.risk_tx_monthly AS
SELECT id,
  SUM(CASE WHEN substr(tx_date,1,7)='2025-02' THEN 1 ELSE 0 END) AS cnt_202502,
  SUM(CASE WHEN substr(tx_date,1,7)='2025-03' THEN 1 ELSE 0 END) AS cnt_202503,
  SUM(CASE WHEN substr(tx_date,1,7)='2025-04' THEN 1 ELSE 0 END) AS cnt_202504,
  SUM(CASE WHEN substr(tx_date,1,7)='2025-02' THEN amount ELSE 0 END) AS amt_202502,
  SUM(CASE WHEN substr(tx_date,1,7)='2025-03' THEN amount ELSE 0 END) AS amt_202503,
  SUM(CASE WHEN substr(tx_date,1,7)='2025-04' THEN amount ELSE 0 END) AS amt_202504,
  SUM(CASE WHEN dc_flag='C' THEN amount ELSE 0 END) AS total_inflow,
  SUM(CASE WHEN dc_flag='D' THEN amount ELSE 0 END) AS total_outflow,
  COUNT(1) AS total_cnt,
  AVG(amount) AS avg_amt,
  MAX(tx_date) AS last_tx_date
FROM aplthive_ohzdl_0mgk1_d.risk_tx_view
GROUP BY id;

CREATE TABLE IF NOT EXISTS aplthive_ohzdl_0mgk1_d.risk_tx_type_channel AS
SELECT id,
  SUM(CASE WHEN tx_type='84' THEN 1 ELSE 0 END) AS type_84_cnt,
  SUM(CASE WHEN tx_type='8101' THEN 1 ELSE 0 END) AS type_8101_cnt,
  SUM(CASE WHEN tx_type='31' THEN 1 ELSE 0 END) AS type_31_cnt,
  SUM(CASE WHEN tx_type='6' THEN 1 ELSE 0 END) AS type_6_cnt,
  SUM(CASE WHEN channel='02' THEN 1 ELSE 0 END) AS ch_02_cnt,
  SUM(CASE WHEN channel='10' THEN 1 ELSE 0 END) AS ch_10_cnt,
  SUM(CASE WHEN channel='01' THEN 1 ELSE 0 END) AS ch_01_cnt,
  SUM(CASE WHEN channel='00' THEN 1 ELSE 0 END) AS ch_00_cnt,
  SUM(CASE WHEN channel='99' THEN 1 ELSE 0 END) AS ch_99_cnt,
  SUM(CASE WHEN tx_type='84' THEN amount ELSE 0 END) AS type_84_amt,
  SUM(CASE WHEN tx_type='8101' THEN amount ELSE 0 END) AS type_8101_amt,
  SUM(CASE WHEN tx_type='31' THEN amount ELSE 0 END) AS type_31_amt,
  SUM(CASE WHEN tx_type='6' THEN amount ELSE 0 END) AS type_6_amt,
  SUM(CASE WHEN channel='02' THEN amount ELSE 0 END) AS ch_02_amt,
  SUM(CASE WHEN channel='10' THEN amount ELSE 0 END) AS ch_10_amt,
  SUM(CASE WHEN channel='01' THEN amount ELSE 0 END) AS ch_01_amt,
  SUM(CASE WHEN channel='00' THEN amount ELSE 0 END) AS ch_00_amt,
  SUM(CASE WHEN channel='99' THEN amount ELSE 0 END) AS ch_99_amt
FROM aplthive_ohzdl_0mgk1_d.risk_tx_view
GROUP BY id;

CREATE TABLE IF NOT EXISTS aplthive_ohzdl_0mgk1_d.enriched_train AS
SELECT m.id, m.label,
  m.f1,m.f2,m.f3,m.f4,m.f5,m.f6,m.f7,m.f8,m.f9,m.f10,m.f11,m.f12,m.f13,m.f14,m.f15,m.f16,m.f17,m.f18,m.f19,m.f20,
  mt.cnt_202502, mt.cnt_202503, mt.cnt_202504,
  mt.amt_202502, mt.amt_202503, mt.amt_202504,
  (mt.cnt_202503 - mt.cnt_202502) AS cnt_mom_03_vs_02,
  (mt.cnt_202504 - mt.cnt_202503) AS cnt_mom_04_vs_03,
  (mt.amt_202503 - mt.amt_202502) AS amt_mom_03_vs_02,
  (mt.amt_202504 - mt.amt_202503) AS amt_mom_04_vs_03,
  mt.total_inflow, mt.total_outflow, mt.total_cnt, mt.avg_amt, mt.last_tx_date,
  tc.* EXCEPT(id),
  COALESCE(m.f14,0) AS mb_login_1m,
  COALESCE(m.f15,0) AS mb_login_3m,
  COALESCE(m.f16,0) AS mb_login_6m,
  CASE WHEN COALESCE(m.f16,0)>0 THEN (COALESCE(m.f15,0)-COALESCE(m.f16,0))/COALESCE(m.f16,1.0) END AS mb_login_6to3_ratio,
  CASE WHEN COALESCE(m.f15,0)>0 THEN (COALESCE(m.f14,0)-COALESCE(m.f15,0))/COALESCE(m.f15,1.0) END AS mb_login_3to1_ratio,
  COALESCE(m.f17,0) AS depo_bal_point,
  COALESCE(m.f18,0) AS depo_bal_mavg3,
  CASE WHEN COALESCE(m.f18,0)>0 THEN (COALESCE(m.f17,0)-COALESCE(m.f18,0))/COALESCE(m.f18,1.0) END AS depo_decay_ratio,
  COALESCE(m.f19,0) AS inv_bal_point,
  COALESCE(m.f20,0) AS inv_bal_mavg3,
  CASE WHEN COALESCE(m.f20,0)>0 THEN (COALESCE(m.f19,0)-COALESCE(m.f20,0))/COALESCE(m.f20,1.0) END AS inv_decay_ratio,
  CASE WHEN COALESCE(m.f18,0)+COALESCE(m.f20,0)>0 THEN (COALESCE(m.f17,0)+COALESCE(m.f19,0)-(COALESCE(m.f18,0)+COALESCE(m.f20,0)))/(COALESCE(m.f18,0)+COALESCE(m.f20,0)) END AS asset_loss_ratio
FROM aplthive_ohzdl_0mgk1_d.market_train m
LEFT JOIN aplthive_ohzdl_0mgk1_d.risk_tx_monthly mt USING(id)
LEFT JOIN aplthive_ohzdl_0mgk1_d.risk_tx_type_channel tc USING(id);

CREATE TABLE IF NOT EXISTS aplthive_ohzdl_0mgk1_d.enriched_test AS
SELECT m.id,
  m.f1,m.f2,m.f3,m.f4,m.f5,m.f6,m.f7,m.f8,m.f9,m.f10,m.f11,m.f12,m.f13,m.f14,m.f15,m.f16,m.f17,m.f18,m.f19,m.f20,
  mt.cnt_202502, mt.cnt_202503, mt.cnt_202504,
  mt.amt_202502, mt.amt_202503, mt.amt_202504,
  (mt.cnt_202503 - mt.cnt_202502) AS cnt_mom_03_vs_02,
  (mt.cnt_202504 - mt.cnt_202503) AS cnt_mom_04_vs_03,
  (mt.amt_202503 - mt.amt_202502) AS amt_mom_03_vs_02,
  (mt.amt_202504 - mt.amt_202503) AS amt_mom_04_vs_03,
  mt.total_inflow, mt.total_outflow, mt.total_cnt, mt.avg_amt, mt.last_tx_date,
  tc.* EXCEPT(id),
  COALESCE(m.f14,0) AS mb_login_1m,
  COALESCE(m.f15,0) AS mb_login_3m,
  COALESCE(m.f16,0) AS mb_login_6m,
  CASE WHEN COALESCE(m.f16,0)>0 THEN (COALESCE(m.f15,0)-COALESCE(m.f16,0))/COALESCE(m.f16,1.0) END AS mb_login_6to3_ratio,
  CASE WHEN COALESCE(m.f15,0)>0 THEN (COALESCE(m.f14,0)-COALESCE(m.f15,0))/COALESCE(m.f15,1.0) END AS mb_login_3to1_ratio,
  COALESCE(m.f17,0) AS depo_bal_point,
  COALESCE(m.f18,0) AS depo_bal_mavg3,
  CASE WHEN COALESCE(m.f18,0)>0 THEN (COALESCE(m.f17,0)-COALESCE(m.f18,0))/COALESCE(m.f18,1.0) END AS depo_decay_ratio,
  COALESCE(m.f19,0) AS inv_bal_point,
  COALESCE(m.f20,0) AS inv_bal_mavg3,
  CASE WHEN COALESCE(m.f20,0)>0 THEN (COALESCE(m.f19,0)-COALESCE(m.f20,0))/COALESCE(m.f20,1.0) END AS inv_decay_ratio,
  CASE WHEN COALESCE(m.f18,0)+COALESCE(m.f20,0)>0 THEN (COALESCE(m.f17,0)+COALESCE(m.f19,0)-(COALESCE(m.f18,0)+COALESCE(m.f20,0)))/(COALESCE(m.f18,0)+COALESCE(m.f20,0)) END AS asset_loss_ratio
FROM aplthive_ohzdl_0mgk1_d.market_test m
LEFT JOIN aplthive_ohzdl_0mgk1_d.risk_tx_monthly mt USING(id)
LEFT JOIN aplthive_ohzdl_0mgk1_d.risk_tx_type_channel tc USING(id);## 银行客户流失预测：端到端解决方案（Notebook）

- 覆盖：EDA、清洗预处理、特征工程、建模（XGBoost/LightGBM/随机森林）、贝叶斯优化（Optuna）、Stacking融合、评估、导出。
- 约束：不使用 seaborn、catboost、imblearn；不使用SMOTE（采用手动重采样）；XGB/LGB 用 Optuna，RF 用随机搜索。
- 时间窗：risk_train 2025-02 至 2025-04，观测点 2025-04-30。

执行顺序：
1) 0步（SQL）：Hive 特征构建与三表融合
2) 1-6步（Python）：EDA → 预处理 → 特征工程 → 调参与训练 → 融合评估 → 导出