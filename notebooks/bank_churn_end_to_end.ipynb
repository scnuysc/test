#### 第0步：Hive SQL - 三表融合与交易特征工程（在Hive中执行）
下面给出的SQL对 `risk_train` 在2025-02至2025-04期间进行交易聚合，提取RFM、流入流出、渠道偏好、月度变化率等特征，并与 `market_train`/`market_test` 通过 `id` 左连接，形成 `enriched_train`/`enriched_test`。为减少噪声与冗余，交易类型保留常见几类计数/金额、同时加入去量纲的变化率与强度特征。

```sql
WITH risk AS (
  SELECT
    id,
    f1 AS trade_code,
    f4 AS dc_flag,
    CAST(COALESCE(REGEXP_REPLACE(CAST(f11 AS STRING), ',', ''), '0') AS DOUBLE) AS amount,
    to_date(f13) AS trade_date,
    f16 AS channel
  FROM aplthive_ohzdl_0mgk1_d.risk_train
  WHERE f13 >= '2025-02-01' AND f13 <= '2025-04-30'
    AND COALESCE(f14, '0') = '0'
),
risk_m AS (
  SELECT id, dc_flag, channel, trade_code, amount, trade_date,
    CASE WHEN trade_date >= '2025-04-01' THEN 'm4'
         WHEN trade_date >= '2025-03-01' THEN 'm3'
         ELSE 'm2' END AS mkey
  FROM risk
),
agg AS (
  SELECT id,
    COUNT(1) AS tx_cnt_3m,
    SUM(amount) AS amt_sum_3m,
    AVG(amount) AS amt_avg_3m,
    MAX(amount) AS amt_max_3m,
    MAX(trade_date) AS last_trade_date,
    COUNT(DISTINCT channel) AS channel_nunique_3m,
    COUNT(DISTINCT trade_code) AS trade_code_nunique_3m,
    SUM(CASE WHEN dc_flag = 'C' THEN 1 ELSE 0 END) AS inflow_cnt_3m,
    SUM(CASE WHEN dc_flag = 'D' THEN 1 ELSE 0 END) AS outflow_cnt_3m,
    SUM(CASE WHEN dc_flag = 'C' THEN amount ELSE 0 END) AS inflow_sum_3m,
    SUM(CASE WHEN dc_flag = 'D' THEN amount ELSE 0 END) AS outflow_sum_3m,
    SUM(CASE WHEN channel IN ('10') THEN 1 ELSE 0 END) AS ch_mobile_cnt_3m,
    SUM(CASE WHEN channel IN ('01','20') THEN 1 ELSE 0 END) AS ch_online_cnt_3m,
    SUM(CASE WHEN channel IN ('00','15') THEN 1 ELSE 0 END) AS ch_counter_cnt_3m,
    SUM(CASE WHEN channel IN ('09') THEN 1 ELSE 0 END) AS ch_atm_cnt_3m,
    SUM(CASE WHEN trade_code = '84' THEN 1 ELSE 0 END) AS tc84_cnt_3m,
    SUM(CASE WHEN trade_code = '8101' THEN 1 ELSE 0 END) AS tc8101_cnt_3m,
    SUM(CASE WHEN trade_code = '6' THEN 1 ELSE 0 END) AS tc6_cnt_3m
  FROM risk
  GROUP BY id
),
agg_m AS (
  SELECT id, mkey,
    COUNT(1) AS tx_cnt_m,
    SUM(amount) AS amt_sum_m,
    SUM(CASE WHEN dc_flag = 'C' THEN amount ELSE 0 END) AS inflow_sum_m,
    SUM(CASE WHEN dc_flag = 'D' THEN amount ELSE 0 END) AS outflow_sum_m
  FROM risk_m
  GROUP BY id, mkey
),
agg_wide AS (
  SELECT a.id,
    MAX(CASE WHEN mkey='m2' THEN tx_cnt_m END) AS tx_cnt_m2,
    MAX(CASE WHEN mkey='m3' THEN tx_cnt_m END) AS tx_cnt_m3,
    MAX(CASE WHEN mkey='m4' THEN tx_cnt_m END) AS tx_cnt_m4,
    MAX(CASE WHEN mkey='m2' THEN amt_sum_m END) AS amt_sum_m2,
    MAX(CASE WHEN mkey='m3' THEN amt_sum_m END) AS amt_sum_m3,
    MAX(CASE WHEN mkey='m4' THEN amt_sum_m END) AS amt_sum_m4,
    MAX(CASE WHEN mkey='m2' THEN inflow_sum_m END) AS inflow_sum_m2,
    MAX(CASE WHEN mkey='m3' THEN inflow_sum_m END) AS inflow_sum_m3,
    MAX(CASE WHEN mkey='m4' THEN inflow_sum_m END) AS inflow_sum_m4,
    MAX(CASE WHEN mkey='m2' THEN outflow_sum_m END) AS outflow_sum_m2,
    MAX(CASE WHEN mkey='m3' THEN outflow_sum_m END) AS outflow_sum_m3,
    MAX(CASE WHEN mkey='m4' THEN outflow_sum_m END) AS outflow_sum_m4
  FROM agg_m a
  GROUP BY a.id
),
final_risk AS (
  SELECT
    a.id,
    a.tx_cnt_3m, a.amt_sum_3m, a.amt_avg_3m, a.amt_max_3m,
    a.inflow_cnt_3m, a.outflow_cnt_3m,
    a.inflow_sum_3m, a.outflow_sum_3m,
    a.channel_nunique_3m, a.trade_code_nunique_3m,
    a.ch_mobile_cnt_3m, a.ch_online_cnt_3m, a.ch_counter_cnt_3m, a.ch_atm_cnt_3m,
    a.tc84_cnt_3m, a.tc8101_cnt_3m, a.tc6_cnt_3m,
    a.last_trade_date,
    w.tx_cnt_m2,w.tx_cnt_m3,w.tx_cnt_m4,
    w.amt_sum_m2,w.amt_sum_m3,w.amt_sum_m4,
    w.inflow_sum_m2,w.inflow_sum_m3,w.inflow_sum_m4,
    w.outflow_sum_m2,w.outflow_sum_m3,w.outflow_sum_m4,
    CASE WHEN COALESCE(w.tx_cnt_m3,0)>0 THEN w.tx_cnt_m4/w.tx_cnt_m3 ELSE NULL END AS tx_cnt_m4_m3_ratio,
    CASE WHEN COALESCE(w.tx_cnt_m2,0)>0 THEN w.tx_cnt_m4/w.tx_cnt_m2 ELSE NULL END AS tx_cnt_m4_m2_ratio,
    CASE WHEN COALESCE(w.amt_sum_m3,0)>0 THEN w.amt_sum_m4/w.amt_sum_m3 ELSE NULL END AS amt_sum_m4_m3_ratio,
    CASE WHEN COALESCE(w.amt_sum_m2,0)>0 THEN w.amt_sum_m4/w.amt_sum_m2 ELSE NULL END AS amt_sum_m4_m2_ratio,
    CASE WHEN COALESCE(a.inflow_sum_3m + a.outflow_sum_3m,0)>0
         THEN COALESCE(w.outflow_sum_m4 - w.inflow_sum_m4,0) / (a.inflow_sum_3m + a.outflow_sum_3m)
         ELSE NULL END AS asset_loss_rate_proxy
  FROM agg a
  LEFT JOIN agg_wide w ON a.id = w.id
)

CREATE TABLE aplthive_ohzdl_0mgk1_d.enriched_train AS
SELECT t.*, fr.*
FROM aplthive_ohzdl_0mgk1_d.market_train t
LEFT JOIN final_risk fr ON t.id = fr.id
;

CREATE TABLE aplthive_ohzdl_0mgk1_d.enriched_test AS
SELECT t.*, fr.*
FROM aplthive_ohzdl_0mgk1_d.market_test t
LEFT JOIN final_risk fr ON t.id = fr.id
;```### 银行客户流失预测：端到端机器学习方案（Hive特征融合 + Python建模）

- SQL 融合：优化 `risk_train` 的月度与3个月窗口聚合，生成 `enriched_train`/`enriched_test`。
- Python：EDA、清洗、手工重采样、特征工程、XGBoost/LightGBM（贝叶斯）与随机森林（随机搜索）、交叉验证（AUC）、TOP20特征可视化与提交导出。

限制：不使用 `seaborn`、`catboost`、`imblearn`。