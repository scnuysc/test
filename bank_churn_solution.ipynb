from collections import defaultdict

# 基础清洗：
# - 统一将明显的非法值映射为缺失；
# - 对目标分类变量进行目标编码（带交叉验证避免泄漏）；
# - 数值变量做极端值截断（winsorize）与缩放；
# - 手动重采样：下采样多数类+上采样少数类（有限制内），不使用SMOTE。


def winsorize_series(s: pd.Series, lower_q: float = 0.01, upper_q: float = 0.99) -> pd.Series:
    x = s.astype(float)
    lo = np.nanquantile(x, lower_q)
    hi = np.nanquantile(x, upper_q)
    return x.clip(lo, hi)


def cross_fit_target_encoding(
    df: pd.DataFrame,
    cols: List[str],
    target: str,
    n_splits: int = 5,
    noise: float = 0.0
) -> Tuple[pd.DataFrame, Dict[str, Dict]]:
    df = df.copy()
    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=RANDOM_STATE)
    global_mean = df[target].mean()
    enc_maps: Dict[str, Dict] = {}

    for col in cols:
        enc_maps[col] = {'global_mean': global_mean, 'map': {}}
        oof = pd.Series(index=df.index, dtype=float)
        for tr_idx, va_idx in skf.split(df, df[target]):
            tr = df.iloc[tr_idx]
            va = df.iloc[va_idx]
            m = tr.groupby(col)[target].mean()
            oof.iloc[va_idx] = va[col].map(m).fillna(global_mean)
        if noise > 0:
            oof = oof + np.random.normal(0, noise, size=len(oof))
        df[f'{col}_te'] = oof
        # 保存全量映射用于测试集
        enc_maps[col]['map'] = df.groupby(col)[target].mean().to_dict()
    return df, enc_maps


def apply_target_encoding(df: pd.DataFrame, enc_maps: Dict[str, Dict]) -> pd.DataFrame:
    df = df.copy()
    for col, m in enc_maps.items():
        global_mean = m['global_mean']
        mp = m['map']
        df[f'{col}_te'] = df[col].map(mp).fillna(global_mean)
    return df


def preprocess(df: pd.DataFrame, is_train: bool = True,
               enc_info: Optional[Dict[str, Dict]] = None) -> Tuple[pd.DataFrame, Optional[Dict[str, Dict]], List[str]]:
    work = df.copy()

    # 删除纯空列或单值列
    nunique = work.nunique(dropna=False)
    drop_cols = [c for c in work.columns if nunique[c] <= 1]
    if drop_cols:
        work = work.drop(columns=drop_cols)

    # 拆分列类型
    id_col = 'id'
    label_col = 'label'
    feature_cols = [c for c in work.columns if c not in [id_col, label_col]]

    numeric_cols, categorical_cols = [], []
    for c in feature_cols:
        if pd.api.types.is_numeric_dtype(work[c]):
            numeric_cols.append(c)
        else:
            categorical_cols.append(c)

    # 尝试解析日期列（若有 last_tx_date 等）
    for c in list(categorical_cols):
        if ('date' in c) or (c.startswith('f11')):
            # 若可解析为日期，转为距锚点天数
            try:
                ts = pd.to_datetime(work[c], errors='coerce')
                if ts.notna().any():
                    work[c + '_days_from_anchor'] = (ANCHOR_DATE - ts).dt.days
                    numeric_cols.append(c + '_days_from_anchor')
                    categorical_cols.remove(c)
                    work = work.drop(columns=[c])
            except Exception:
                pass

    # 缺失值：数值填充为中位数，类别填充为 'UNK'
    medians = work[numeric_cols].median(numeric_only=True)
    work[numeric_cols] = work[numeric_cols].fillna(medians)
    for c in categorical_cols:
        work[c] = work[c].fillna('UNK').astype(str)

    # 高基数类别截断（如职业、渠道等）
    def cap_top_k(series: pd.Series, k: int = 50) -> pd.Series:
        vc = series.value_counts()
        keep = set(vc.index[:k])
        return series.where(series.isin(keep), other='OTHER')

    for c in categorical_cols:
        work[c] = cap_top_k(work[c], k=60)

    # 目标编码
    enc_maps = enc_info
    if is_train:
        work, enc_maps = cross_fit_target_encoding(work, categorical_cols, target='label', n_splits=5, noise=0.0)
    else:
        if enc_maps is None:
            raise ValueError('Test preprocessing requires enc_maps')
        work = apply_target_encoding(work, enc_maps)

    # 数值截断 + 归一化
    for c in numeric_cols:
        work[c] = winsorize_series(work[c].astype(float), 0.01, 0.99)

    scaler = StandardScaler()
    scaled_cols = numeric_cols + [f'{c}_te' for c in categorical_cols]
    work[scaled_cols] = scaler.fit_transform(work[scaled_cols]) if is_train else scaler.transform(work[scaled_cols])

    # 返回：预处理后的DataFrame、编码映射、最终特征列
    final_features = [c for c in work.columns if c not in ['id', 'label']]
    return work, enc_maps, final_features


