# 简单手动重采样：下采样多数类+上采样少数类（仅用于训练集）
def manual_resample(X: pd.DataFrame, y: pd.Series, pos_ratio_target: float = 0.3, random_state: int = 2025):
    pos_idx = y[y == 1].index
    neg_idx = y[y == 0].index
    n_pos = len(pos_idx)
    n_neg = len(neg_idx)

    # 上采样正样本
    target_pos = int(pos_ratio_target * (n_pos + n_neg) / (1 - pos_ratio_target))
    n_add = max(0, target_pos - n_pos)
    add_idx = np.random.choice(pos_idx, size=n_add, replace=True) if n_add > 0 else []

    # 可选：下采样负样本（控制总量）
    new_neg_idx = neg_idx
    # 不下采样或轻微下采样，这里保持原样，防止信息损失

    new_idx = np.concatenate([pos_idx, add_idx, new_neg_idx])
    np.random.shuffle(new_idx)
    return X.loc[new_idx], y.loc[new_idx]

