def safe_read_csv(path: str) -> Optional[pd.DataFrame]:
    try:
        if os.path.exists(path):
            df = pd.read_csv(path)
            return df
    except Exception as e:
        print(f'Failed to read {path}: {e}')
    return None

train = None
for p in TRAIN_PATHS:
    df = safe_read_csv(p)
    if df is not None:
        train = df
        print(f'Loaded train: {p}, shape={df.shape}')
