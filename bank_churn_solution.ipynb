# - 登录活跃趋势：1m/3m/6m 的趋势指标与稳定性（方差）
# - 交易月度环比与趋势（如 cnt/amt 增长率）
# - 存款/投资占比、总资产、变化率分桶


def add_business_features(df: pd.DataFrame) -> pd.DataFrame:
    work = df.copy()
    # 登录趋势
    if set(['f14','f15','f16']).issubset(work.columns):
        work['mb_login_total'] = work[['f14','f15','f16']].sum(axis=1)
        work['mb_login_var'] = work[['f14','f15','f16']].var(axis=1)
        work['mb_login_trend_6to1'] = work['f14'] - work['f16']
        work['mb_login_ratio_6to1'] = (work['f14'] + 1.0) / (work['f16'] + 1.0)

    # 交易月度环比
    for prefix in ['cnt', 'amt']:
        c2 = f'{prefix}_202502'
        c3 = f'{prefix}_202503'
        c4 = f'{prefix}_202504'
        if set([c2, c3, c4]).issubset(work.columns):
            work[f'{prefix}_mom_03_vs_02'] = (work[c3] - work[c2])
            work[f'{prefix}_mom_04_vs_03'] = (work[c4] - work[c3])
            work[f'{prefix}_ratio_03_vs_02'] = (work[c3] + 1.0) / (work[c2] + 1.0)
            work[f'{prefix}_ratio_04_vs_03'] = (work[c4] + 1.0) / (work[c3] + 1.0)

    # 总资产与占比
    for a, b, name in [
        ('f17','f19','asset_point'),
        ('f18','f20','asset_mavg3')
    ]:
        if a in work.columns and b in work.columns:
            work[f'{name}_sum'] = work[a].fillna(0) + work[b].fillna(0)
            work[f'{name}_inv_ratio'] = (work[b].fillna(0) + 1.0) / (work[f'{name}_sum'] + 1.0)

    # 存款衰减/投资衰减已在SQL中有，补充分桶
    for col in ['depo_decay_ratio', 'inv_decay_ratio', 'asset_loss_ratio']:
        if col in work.columns:
            work[f'{col}_bin'] = pd.qcut(work[col], q=10, duplicates='drop', labels=False)

    return work

